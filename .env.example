# =============================================================================
# AI WhatsApp E-commerce Support Agent: environment template
# Copy to .env (git-ignored) and fill in. NEVER commit real values.
# Full credential instructions: docs/credentials.md
# =============================================================================

# --- Mode ---------------------------------------------------------------------
# true  = every integration is mocked, data is fictional, demo secrets are used.
# false = live mode: all credentials below are REQUIRED and validated at startup.
DEMO_MODE=true
# local = gateway runs the agent flow itself (mirrors the n8n workflow)
# n8n   = gateway forwards each turn to the n8n workflow
ORCHESTRATOR=local
HOST=127.0.0.1
PORT=3000

# --- Gateway secrets (generate each with: openssl rand -hex 32) ----------------
# n8n -> gateway tool API (Authorization: Bearer <TOOLS_API_TOKEN>)
TOOLS_API_TOKEN=
# Signs per-message turn tokens; must be stable across restarts
TURN_TOKEN_SECRET=
# Protects /api/* (dashboard) in live mode. Open console as /#token=<ADMIN_TOKEN>
ADMIN_TOKEN=

# --- n8n (only when ORCHESTRATOR=n8n) ------------------------------------------
N8N_INBOUND_WEBHOOK_URL=http://n8n:5678/webhook/synvoca-whatsapp-turn
# Same value as the "Synvoca Gateway → n8n" header credential in n8n
N8N_GATEWAY_TOKEN=
# docker-compose only: encrypts credentials stored by n8n
N8N_ENCRYPTION_KEY=

# --- Meta WhatsApp Cloud API ---------------------------------------------------
# App Dashboard > App settings > Basic > App secret. Used to verify X-Hub-Signature-256.
META_APP_SECRET=
# Any long random string; paste the same value into the webhook config in Meta.
META_VERIFY_TOKEN=
# System user access token with whatsapp_business_messaging (+ whatsapp_business_management)
WHATSAPP_ACCESS_TOKEN=
# WhatsApp > API Setup > Phone number ID (not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# Check the current Graph API version in the Meta changelog before going live
GRAPH_API_VERSION=v23.0
# Approved utility template used ONLY for human-agent follow-ups outside the 24h window
WHATSAPP_FOLLOWUP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# --- OpenAI --------------------------------------------------------------------
OPENAI_API_KEY=
# Must support Structured Outputs on the Responses API. Also update the model in the
# n8n "Build OpenAI Request" node if you change it.
OPENAI_MODEL=gpt-5-mini
# Optional, for reasoning models (e.g. minimal / low). Leave empty for non-reasoning models.
OPENAI_REASONING_EFFORT=

# --- HubSpot (private app) -----------------------------------------------------
# Scopes: crm.objects.contacts.read, crm.objects.contacts.write, tickets
HUBSPOT_ACCESS_TOKEN=
# Default "Support Pipeline" is "0" and its first stage "1"; verify in your portal.
HUBSPOT_TICKET_PIPELINE=0
HUBSPOT_TICKET_STAGE=1

# --- WooCommerce REST API ------------------------------------------------------
# https only. Keys need READ permission only.
WOOCOMMERCE_BASE_URL=https://shop.example.com
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
# Optional order meta key holding a store-provided delivery estimate (YYYY-MM-DD).
# If unset, the bot says the estimate is not available. It never guesses.
WOOCOMMERCE_ETA_META_KEY=
STORE_NAME=Your Store
STORE_CURRENCY=EUR
# Country calling code used to normalise billing phones saved without one (e.g. 30 for Greece)
DEFAULT_COUNTRY_CALLING_CODE=
SUPPORT_EMAIL=support@example.com

# --- Privacy, safety and limits ------------------------------------------------
LOG_LEVEL=info
# Keep false in production: logs record message length only, not content.
LOG_MESSAGE_TEXT=false
CONVERSATION_RETENTION_HOURS=72
DEDUPE_TTL_HOURS=72
ORDER_VERIFICATION_MAX_FAILURES=3
ORDER_VERIFICATION_WINDOW_MINUTES=60
CLASSIFIER_MIN_CONFIDENCE=0.55

# --- Docker compose host ports (optional) --------------------------------------
GATEWAY_HOST_PORT=3000
N8N_HOST_PORT=5678
