    {
      "id": "00000000-0000-4000-8000-000000000011",
      "name": "Normalize Classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        300
      ],
      "parameters": {
        "jsCode": "// Accepts either a gateway rules response ({ classification, source }) or an OpenAI Responses API body.\nconst j = $input.first().json;\nlet classification = null;\nlet source = 'fallback';\nif (j && j.classification) {\n  classification = j.classification;\n  source = j.source === 'mock' ? 'mock' : 'fallback';\n} else if (j && Array.isArray(j.output)) {\n  source = 'openai';\n  for (const item of j.output) {\n    if (item.type !== 'message') continue;\n    for (const part of item.content || []) {\n      if (part.type === 'output_text') {\n        try { classification = JSON.parse(part.text); } catch (e) { classification = null; }\n      }\n    }\n  }\n}\n// No validation here on purpose: the gateway guard validates and decides.\nreturn [{ json: { classification, classification_source: source } }];"
      },
      "notes": "Extracts the JSON classification. The server guard (next node) validates it against the schema."
    },
