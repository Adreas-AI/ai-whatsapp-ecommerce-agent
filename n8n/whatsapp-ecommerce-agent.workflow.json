    {
      "id": "00000000-0000-4000-8000-000000000001",
      "name": "Inbound Turn (from Gateway)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "7d1c6a0e-2f4b-4c8e-9a51-5e7f3b9d2c10",
      "parameters": {
        "httpMethod": "POST",
        "path": "synvoca-whatsapp-turn",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "synvocaGatewayHdr",
          "name": "Synvoca Gateway → n8n (X-Gateway-Token)"
        }
      },
      "notes": "Receives the redacted turn envelope from the Synvoca gateway (which already verified X-Hub-Signature-256 and de-duplicated the message). Header auth: X-Gateway-Token. Responds 200 immediately."
    },
    {
      "id": "00000000-0000-4000-8000-000000000002",
      "name": "Validate Envelope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        300
      ],
      "parameters": {
        "jsCode": "// EDIT: where n8n can reach the gateway's tool API. Overridable with env SYNVOCA_TOOLS_BASE_URL\n// when N8N_BLOCK_ENV_ACCESS_IN_NODE=false.\nconst DEFAULT_TOOLS_BASE_URL = 'http://gateway:3000';\nlet toolsBaseUrl = DEFAULT_TOOLS_BASE_URL;\ntry { if ($env.SYNVOCA_TOOLS_BASE_URL) toolsBaseUrl = $env.SYNVOCA_TOOLS_BASE_URL; } catch (e) { /* env access blocked */ }\n\nconst body = $input.first().json.body || {};\nif (body.schema !== 'synvoca.whatsapp.turn.v1' || typeof body.turn_token !== 'string' || typeof body.message_id !== 'string') {\n  throw new Error('Rejected envelope: unexpected schema');\n}\nreturn [{ json: {\n  message_id: body.message_id,\n  turn_token: body.turn_token,\n  message_type: String(body.message_type || 'unknown'),\n  text_redacted: typeof body.text_redacted === 'string' ? body.text_redacted.slice(0, 4096) : null,\n  awaiting: body.awaiting || null,\n  demo_mode: body.demo_mode === true,\n  tools_base_url: String(toolsBaseUrl).replace(/\\/+$/, ''),\n} }];"
      },
      "notes": "Normalises the envelope. Contains no raw text, email or full phone number: the gateway redacts before forwarding."
    },
    {
      "id": "00000000-0000-4000-8000-000000000003",
      "name": "Get Conversation Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Validate Envelope').first().json.tools_base_url }}/tools/context",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Turn-Token",
              "value": "={{ $('Validate Envelope').first().json.turn_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "synvocaToolsApiHd",
          "name": "Synvoca Tools API (Authorization: Bearer)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500,
      "notes": "Conversation state: handoff flag, what the bot is waiting for, 24h window, demo mode. Fails the execution if the gateway is unreachable (set an Error Workflow to alert).",
      "notesInFlow": false
    },
    {
      "id": "00000000-0000-4000-8000-000000000004",
